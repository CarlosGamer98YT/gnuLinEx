#!/bin/bash
# /usr/local/bin/gnulinex-lock
# Bloqueador de pantalla corporativo para gnuLinEx (Grulla)

CONFIG_FILE="$HOME/.config/swaylock/config"
if [ ! -f "$CONFIG_FILE" ]; then
    CONFIG_FILE="/etc/skel/.config/swaylock/config"
fi

if command -v swaylock >/dev/null 2>&1; then
    if [ -f "$CONFIG_FILE" ]; then
        swaylock --config "$CONFIG_FILE"
    else
        swaylock -i /usr/share/backgrounds/default.png -s fill
    fi
elif command -v hyprlock >/dev/null 2>&1; then
    hyprlock
fi
