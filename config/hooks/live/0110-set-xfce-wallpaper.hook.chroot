#!/bin/sh
# Este hook se ejecuta en el chroot y configura el fondo de pantalla
# predeterminado para que XFCE lo use automáticamente, independientemente
# del nombre del monitor (eDP1, HDMI1, etc.).

echo "I: Configurando default.png como fondo de escritorio por defecto..."

# 1. Configurar la alternativa de Debian
update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background /usr/share/backgrounds/default.png 99
update-alternatives --set desktop-background /usr/share/backgrounds/default.png

# 2. Reemplazar fondos predeterminados comunes de XFCE por si acaso (haciendo symlinks)
mkdir -p /usr/share/backgrounds/xfce
ln -sf /usr/share/backgrounds/default.png /usr/share/backgrounds/xfce/xfce-shapes.svg
ln -sf /usr/share/backgrounds/default.png /usr/share/backgrounds/xfce/xfce-teal.jpg
ln -sf /usr/share/backgrounds/default.png /usr/share/backgrounds/xfce/xfce-blue.jpg
ln -sf /usr/share/backgrounds/default.png /usr/share/backgrounds/xfce/xfce-stripes.png
ln -sf /usr/share/backgrounds/default.png /usr/share/backgrounds/xfce/xfce-verticals.png
